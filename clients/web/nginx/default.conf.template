map $http_upgrade $knot_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    client_max_body_size 120m;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "open\n";
    }

    location /api/ {
        proxy_pass ${KNOT_API_UPSTREAM}/;
        include /etc/nginx/snippets/knot-proxy.conf;
    }

    location /gateway/ {
        proxy_pass ${KNOT_GATEWAY_UPSTREAM}/;
        include /etc/nginx/snippets/knot-proxy.conf;
    }

    location /presence/ {
        proxy_pass ${KNOT_PRESENCE_UPSTREAM}/;
        include /etc/nginx/snippets/knot-proxy.conf;
    }

    location /attachments/ {
        proxy_pass ${KNOT_ATTACHMENTS_UPSTREAM}/;
        include /etc/nginx/snippets/knot-proxy.conf;
    }

    location /preview/ {
        proxy_pass ${KNOT_PREVIEW_UPSTREAM}/;
        include /etc/nginx/snippets/knot-proxy.conf;
    }

    location / {
        proxy_pass ${KNOT_WEB_UPSTREAM};
        include /etc/nginx/snippets/knot-proxy.conf;
    }
}
