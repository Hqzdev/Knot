map $http_upgrade $knot_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 20m;

    include /tmp/knot-security.conf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass ${KNOT_API_UPSTREAM}/;
        include /etc/nginx/snippets/knot-proxy.conf;
    }

    location /gateway/ {
        proxy_pass ${KNOT_GATEWAY_UPSTREAM}/;
        include /etc/nginx/snippets/knot-proxy.conf;
    }

    location /presence/ {
        proxy_pass ${KNOT_PRESENCE_UPSTREAM}/;
        include /etc/nginx/snippets/knot-proxy.conf;
    }

    location /attachments/ {
        proxy_pass ${KNOT_ATTACHMENTS_UPSTREAM}/;
        include /etc/nginx/snippets/knot-proxy.conf;
    }

    location /push/ {
        proxy_pass ${KNOT_PUSH_UPSTREAM}/;
        include /etc/nginx/snippets/knot-proxy.conf;
    }

    location /assets/ {
        try_files $uri =404;
        include /tmp/knot-security.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /crypto/ {
        try_files $uri =404;
        include /tmp/knot-security.conf;
        add_header Cache-Control "no-cache";
    }

    location = /index.html {
        include /tmp/knot-security.conf;
        add_header Cache-Control "no-store";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
