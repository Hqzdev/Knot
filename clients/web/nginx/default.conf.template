map $http_upgrade $knot_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    client_max_body_size 120m;
    access_log off;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' http: ws:; img-src 'self' data: http: https:; media-src 'self' http: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "open\n";
    }

    location /api/ {
        proxy_pass ${KNOT_API_UPSTREAM}/;
        include /etc/nginx/snippets/knot-proxy.conf;
    }

    location /gateway/ {
        proxy_pass ${KNOT_GATEWAY_UPSTREAM}/;
        include /etc/nginx/snippets/knot-proxy.conf;
    }

    location /presence/ {
        proxy_pass ${KNOT_PRESENCE_UPSTREAM}/;
        include /etc/nginx/snippets/knot-proxy.conf;
    }

    location /attachments/ {
        proxy_pass ${KNOT_ATTACHMENTS_UPSTREAM}/;
        include /etc/nginx/snippets/knot-proxy.conf;
    }

    location /preview/ {
        proxy_pass ${KNOT_PREVIEW_UPSTREAM}/;
        include /etc/nginx/snippets/knot-proxy.conf;
    }

    location /bot/ {
        proxy_pass ${KNOT_BOT_UPSTREAM}/;
        include /etc/nginx/snippets/knot-proxy.conf;
    }

    location / {
        proxy_pass ${KNOT_WEB_UPSTREAM};
        include /etc/nginx/snippets/knot-proxy.conf;
    }
}
